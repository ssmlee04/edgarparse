    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "license": "MIT"
}
